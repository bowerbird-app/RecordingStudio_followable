<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: t("recording_studio_followable.sign_in.title"),
    subtitle: t("recording_studio_followable.sign_in.subtitle"),
    variant: :h1
  ) %>

  <% if flash[:alert].present? %>
    <%= render FlatPack::Alert::Component.new(description: flash[:alert], style: :danger, icon: true) %>
  <% end %>

  <%= form_with url: follow_sign_in_path, method: :post, data: { turbo_frame: "_top" } do %>
    <div class="flex flex-col gap-4">
      <%= render FlatPack::EmailInput::Component.new(
        name: "email",
        label: t("recording_studio_followable.sign_in.email_label"),
        value: params[:email],
        placeholder: "you@example.com",
        required: true
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: t("recording_studio_followable.sign_in.send"),
        type: :submit,
        style: :primary,
        size: :md
      ) %>
    </div>
  <% end %>
</div>
