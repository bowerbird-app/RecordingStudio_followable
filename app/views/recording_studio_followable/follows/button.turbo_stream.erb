<% overrides = @button_overrides || {} %>
<% frame = @button_frame_id.presence || RecordingStudioFollowable::FollowButtonComponent.frame_id(target: @target_recording, root: @follow_root) %>
<%= turbo_stream.replace frame do %>
  <%= follow_button(
        @target_recording,
        root: @follow_root,
        follow: overrides[:follow],
        following: overrides[:following]
      ) %>
<% end %>
