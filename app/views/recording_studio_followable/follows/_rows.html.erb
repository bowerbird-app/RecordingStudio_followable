<% follows.each do |follow_recording| %>
  <% target = follow_recording.recordable.target_recording %>
  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body do %>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <% url = follow_target_url(target) %>
        <% if url.present? %>
          <%= render FlatPack::Link::Component.new(href: url, class: "text-sm leading-6") do %>
            <%= follow_target_title(follow_recording) %>
          <% end %>
        <% else %>
          <p class="text-sm leading-6"><%= follow_target_title(follow_recording) %></p>
        <% end %>
        <%= follow_button(target, root: @follow_root) %>
      </div>
    <% end %>
  <% end %>
<% end %>
<% if next_cursor.present? %>
  <%= turbo_frame_tag follows_next_frame_id(next_cursor), src: follows_path(cursor: next_cursor), loading: :lazy do %>
    <%= render FlatPack::Button::Component.new(
      text: t("recording_studio_followable.follows.load_more"),
      href: follows_path(cursor: next_cursor),
      style: :ghost,
      size: :md
    ) %>
  <% end %>
<% end %>
