<div id="<%= frame_id %>">
  <% if following? %>
    <%= render FlatPack::Button::Dropdown::Component.new(
      text: appearance.following.label,
      style: appearance.following.style,
      size: :md,
      icon: appearance.following.icon
    ) do |dropdown| %>
      <% dropdown.menu_item(
        text: appearance.unfollow_label,
        icon: appearance.unfollow_icon,
        href: request_url,
        data: {
          turbo_method: :delete,
          turbo_stream: true
        }
      ) %>
    <% end %>
  <% elsif sign_in? %>
    <%= render FlatPack::Button::Component.new(
      text: appearance.follow.label,
      style: appearance.follow.style,
      size: :md,
      icon: appearance.follow.icon,
      href: sign_in_url,
      target: (embedded? ? "_blank" : nil),
      rel: (embedded? ? "noopener" : nil),
      data: embedded? ? { turbo: false } : { turbo_frame: "_top" }
    ) %>
  <% else %>
    <%= form_with url: follow_url, method: :post, data: { turbo_stream: true } do %>
      <%= hidden_field_tag :target_id, target.id, id: nil %>
      <%= hidden_field_tag :root_id, root.id, id: nil %>
      <% appearance.fields.each do |name, value| %>
        <%= hidden_field_tag name, value, id: nil %>
      <% end %>
      <%= render FlatPack::Button::Component.new(
        text: appearance.follow.label,
        type: :submit,
        style: appearance.follow.style,
        size: :md,
        icon: appearance.follow.icon
      ) %>
    <% end %>
  <% end %>
</div>
