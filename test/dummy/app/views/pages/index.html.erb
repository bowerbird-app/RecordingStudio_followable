<% dummy_page_nav(title: "Pages", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Pages in this workspace",
    subtitle: "Open one to follow it from here, or from another workspace.",
    variant: :h1
  ) %>

  <% if @pages.blank? %>
    <p class="text-sm leading-6">No pages in this workspace yet.</p>
  <% else %>
    <div class="flex flex-col gap-3">
      <% @pages.each do |page| %>
        <%= render FlatPack::Button::Component.new(
          text: page.title,
          style: :ghost,
          size: :md,
          href: page_path(page)
        ) %>
      <% end %>
    </div>
  <% end %>
</div>
