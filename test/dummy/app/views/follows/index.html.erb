<% dummy_page_nav(back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Following",
    variant: :h1
  ) %>

  <% if @follows.blank? %>
    <p class="text-sm leading-6">Nothing on the list yet. Open a page and hit Follow.</p>
  <% else %>
    <div class="flex flex-col gap-4">
      <% @follows.each do |follow_recording| %>
        <% target = follow_recording.recordable.target_recording %>
        <%= render FlatPack::Card::Component.new do |card| %>
          <% card.body do %>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <% url = follow_target_url(target) %>
              <% if url.present? %>
                <%= render FlatPack::Link::Component.new(href: url, class: "text-sm leading-6") do %>
                  <%= follow_target_title(follow_recording) %>
                <% end %>
              <% else %>
                <p class="text-sm leading-6"><%= follow_target_title(follow_recording) %></p>
              <% end %>
              <%= follow_button(target) %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
