<% dummy_page_nav(title: "Followable", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Keep an eye on a page",
    subtitle: "Follow from this workspace. News lands in this workspace inbox.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: @page&.title || "Getting Started",
          subtitle: "A page in Studio Workspace. Follow it from whichever workspace you have open.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <% if @page_recording && @follow_root && RecordingStudioAccessible.authorized?(actor: current_user, recording: @page_recording, role: :view) && RecordingStudioAccessible.authorized?(actor: current_user, recording: @follow_root, role: :view) %>
          <%= render RecordingStudioFollowable::FollowButtonComponent.new(
            target: @page_recording,
            root: @follow_root,
            following: @following,
            follow_url: main_app.follows_path,
            unfollow_url: @following ? main_app.follow_path(@following) : main_app.follows_path
          ) %>
        <% else %>
          <p class="text-sm leading-6">Open a workspace you can use, then you can follow this page.</p>
        <% end %>
      <% end %>

      <% if @page.present? %>
        <% card.footer do %>
          <div class="flex flex-wrap gap-3">
            <%= render FlatPack::Button::Component.new(
              text: "Open page",
              style: :ghost,
              size: :md,
              href: main_app.page_path(@page)
            ) %>
            <% if @following %>
              <%= form_with url: notify_followers_page_path(@page), method: :post, local: true do %>
                <%= hidden_field_tag :event_key, "dummy-home-#{@page.id}" %>
                <%= render FlatPack::Button::Component.new(
                  text: "Ping followers",
                  type: :submit,
                  style: :secondary,
                  size: :md
                ) %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "This workspace is following",
          subtitle: "Stored with the open workspace, even when the page lives elsewhere.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <% if @follows.blank? %>
          <p class="text-sm leading-6">Nothing on the list yet. Follow a page to fill it.</p>
        <% else %>
          <ul class="space-y-3 text-sm leading-6">
            <% @follows.each do |follow_recording| %>
              <li><%= follow_target_title(follow_recording) %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <% card.footer do %>
        <%= render FlatPack::Button::Component.new(
          text: "See the full list",
          style: :ghost,
          size: :md,
          href: main_app.follows_path
        ) %>
      <% end %>
    <% end %>
  </div>
</div>
